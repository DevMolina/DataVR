{
  "name": "creacion-masiva-usuarios",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:vr1": "cross-env SERVIDOR=vr1 playwright test",
    "test:vr2": "cross-env SERVIDOR=vr2 playwright test",
    "test:vr3": "cross-env SERVIDOR=vr3 playwright test",
    "test:headed": "playwright test --headed",
    "test:masivo": "playwright test -c playwright.runner.config.ts",
    "test:masivo:vr1": "cross-env SERVIDOR=vr1 playwright test -c playwright.runner.config.ts",
    "test:masivo:vr2": "cross-env SERVIDOR=vr2 playwright test -c playwright.runner.config.ts",
    "test:masivo:vr3": "cross-env SERVIDOR=vr3 playwright test -c playwright.runner.config.ts",
    "test:negativos": "playwright test tests/casos-negativos",
    "test:negativos:vr1": "cross-env SERVIDOR=vr1 playwright test tests/casos-negativos",
    "test:negativos:vr2": "cross-env SERVIDOR=vr2 playwright test tests/casos-negativos",
    "test:negativos:vr3": "cross-env SERVIDOR=vr3 playwright test tests/casos-negativos",
    "test:positivos": "playwright test tests/casos-positivos",
    "test:positivos:vr1": "cross-env SERVIDOR=vr1 playwright test tests/casos-positivos",
    "test:positivos:vr2": "cross-env SERVIDOR=vr2 playwright test tests/casos-positivos",
    "test:positivos:vr3": "cross-env SERVIDOR=vr3 playwright test tests/casos-positivos",
    "test:validaciones": "playwright test tests/validaciones",
    "report": "playwright show-report",
    "report:masivo": "playwright show-report playwright-report-runner",
    "verificar-placa": "ts-node scripts/verificar-placa.ts",
    "verificar-contacto": "ts-node scripts/verificar-contacto.ts",
    "verificar-epcs": "ts-node scripts/verificar-epcs.ts",
    "agregar-vehiculo": "ts-node scripts/agregar-vehiculo.ts",
    "agregar-vehiculo:vr1": "cross-env SERVIDOR=vr1 ts-node scripts/agregar-vehiculo.ts",
    "agregar-vehiculo:vr2": "cross-env SERVIDOR=vr2 ts-node scripts/agregar-vehiculo.ts",
    "agregar-vehiculo:vr3": "cross-env SERVIDOR=vr3 ts-node scripts/agregar-vehiculo.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "@types/oracledb": "^7.0.2",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^16.4.5",
    "oracledb": "^6.5.1",
    "randexp": "^0.5.3"
  }
}
