# Credenciales Oracle de Vía Rápida 3 (https://tstviarapida.co:8760).
# Copiar como .env.vr3 y completar. .env.vr3 está en .gitignore — nunca se
# debe commitear con credenciales reales.
#
# Si vienes del setup anterior de un único servidor, este es el reemplazo
# directo de tu antiguo .env (Vía Rápida 3 era el único servidor probado).

ORACLE_USER=
ORACLE_PASSWORD=
# Formato: host:puerto/service_name
ORACLE_CONNECT_STRING=
